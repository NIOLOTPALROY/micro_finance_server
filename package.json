{
  "name": "micro-finance-backend",
  "version": "1.0.0",
  "description": "Stateful authentication backend with Fastify, PostgreSQL and Kysely",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc && esbuild src/server.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server.js",
    "start": "node dist/server.js",
    "db:migrate": "node-pg-migrate -m src/db/migrations up",
    "db:seed": "tsx src/db/seed.ts",
    "db:generate": "kysely-codegen --url \"$DATABASE_URL\" --out-file src/db/database.types.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui"
  },
  "keywords": [
    "stateful-auth",
    "fastify",
    "postgresql",
    "kysely",
    "typescript"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1172.0",
    "@aws-sdk/s3-presigned-post": "^3.1172.0",
    "@aws-sdk/s3-request-presigner": "^3.1172.0",
    "@fastify/cookie": "^11.1.5",
    "@fastify/cors": "^11.4.3",
    "@fastify/session": "^11.1.6",
    "@fastify/swagger": "^9.9.5",
    "@fastify/swagger-ui": "^6.1.4",
    "connect-pg-simple": "^10.0.0",
    "dotenv": "^18.0.10",
    "fastify": "^5.12.8",
    "fastify-type-provider-zod": "^7.0.0",
    "node-pg-migrate": "^7.6.1",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/connect-pg-simple": "^7.0.3",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.2",
    "@vitest/ui": "^5.1.0",
    "esbuild": "^0.28.2",
    "supertest": "^7.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.21.5": true,
    "fsevents@2.3.3": true
  }
}
