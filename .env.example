# PostgreSQL
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=micro_finance
PG_USER=postgres
PG_PASSWORD=postgres

# Session & Authentication
SESSION_SECRET=change-me-in-production-secret-key

# Member personal data encryption (64 hexadecimal characters / 32 bytes)
MEMBER_DATA_ENCRYPTION_KEY=

# Private member file storage (replace the bucket and region with your values)
AWS_REGION=your-aws-region
AWS_S3_BUCKET=your-private-bucket-name
AWS_S3_IMAGES_PREFIX=members/images
AWS_S3_DOCUMENTS_PREFIX=members/documents
AWS_S3_UPLOAD_URL_TTL_SECONDS=300
AWS_S3_DOWNLOAD_URL_TTL_SECONDS=300
AWS_S3_MAX_IMAGE_BYTES=5242880
AWS_S3_MAX_DOCUMENT_BYTES=10485760

# Local development only; production should use an IAM role.
# AWS_PROFILE=default
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Host port published by Docker Compose
APP_PORT=3000
